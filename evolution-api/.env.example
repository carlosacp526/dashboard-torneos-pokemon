# Copiá este archivo a ".env" (sin ".example") y poné tus propios valores.
# El ".env" real NO se sube a git — ver .gitignore.

# Clave que usará pendientes.py para autenticarse contra Evolution API
# (se pega en el campo "API key" del panel de Pendientes, no se guarda en el código)
AUTHENTICATION_API_KEY=cambia-esto-por-una-clave-larga-y-aleatoria

# Contraseña de la base de datos Postgres que usa Evolution API internamente
POSTGRES_PASSWORD=cambia-esto-tambien
